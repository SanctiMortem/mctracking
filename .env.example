# MTG Commander Tracker — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# Neon (PostgreSQL serverless)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Clerk Authentication
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Google OAuth (configured in Clerk dashboard)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AdMob (Free tier monetization)
ADMOB_APP_ID_IOS=ca-app-pub-...~...
ADMOB_APP_ID_ANDROID=ca-app-pub-...~...
ADMOB_BANNER_UNIT_ID=ca-app-pub-.../...
ADMOB_INTERSTITIAL_UNIT_ID=ca-app-pub-.../...
