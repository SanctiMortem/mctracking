{
  "name": "mtg-commander-tracker",
  "version": "0.1.0",
  "factoryVersion": "1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "jest --watchAll=false",
    "test:unit": "jest --watchAll=false --selectProjects unit",
    "test:integration": "jest --watchAll=false --selectProjects integration",
    "test:coverage": "jest --watchAll=false --coverage",
    "test:watch": "jest --watchAll",
    "test:e2e": "maestro test e2e/",
    "test:e2e:ios": "maestro test e2e/ --platform ios",
    "test:e2e:android": "maestro test e2e/ --platform android",
    "build": "tsc --noEmit",
    "build:local": "eas build --local --platform all --profile preview",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.31",
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "^0.45.2",
    "expo": "~55.0.14",
    "expo-constants": "~55.0.13",
    "expo-iap": "^1.0.0",
    "expo-linking": "~55.0.12",
    "expo-localization": "~55.0.13",
    "expo-router": "~55.0.12",
    "expo-secure-store": "~55.0.13",
    "expo-status-bar": "~55.0.5",
    "i18next": "^26.0.4",
    "react": "19.2.5",
    "react-i18next": "^17.0.2",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-google-mobile-ads": "^14.0.0",
    "react-native-reanimated": "~4.3.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.24.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "^55.0.17",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.15",
    "react-test-renderer": "19.2.5",
    "typescript": "~5.5.0"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "expo-modules-core": "~55.0.22"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "bufferutil",
      "utf-8-validate"
    ]
  }
}
